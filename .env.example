# WhatsApp dedicado (opcional). Informe somente dígitos, com DDI e DDD.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Supabase público. Necessário para conteúdo dinâmico e acesso ao /admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase somente no servidor. A URL pode ser omitida se igual à pública.
# A service role key habilita a persistência dos orçamentos. Nunca exponha no navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
